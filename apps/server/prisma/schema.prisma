// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())

  email        String        @unique
  passwordHash String

  displayName  String

  streetName   String
  houseNumber  Int

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sentLetters  Letter[]      @relation("SentLetters")
  receivedLetters Letter[]   @relation("ReceivedLetters")
  focusSessions FocusSession[]
  @@unique([streetName, houseNumber])
}

enum LetterStatus {
  DRAFT
  SENT
}

model Letter {
  id            String         @id @default(cuid())
  content       String
  senderId      String
  recipientId   String?

  senderName    String?
  recipientName String?
  status        LetterStatus   @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sentAt        DateTime?

  sender        User           @relation("SentLetters", fields: [senderId], references: [id])
  recipient     User?          @relation("ReceivedLetters", fields: [recipientId], references: [id])
}

model FocusSession {
  id                    String   @id @default(cuid())
  userId                String
  plannedDurationMinutes Int
  actualDurationMinutes  Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Track {
  id       String   @id @default(cuid())
  title    String
  url      String
  duration Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
